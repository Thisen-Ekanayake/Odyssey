Panels:
- Class: rviz_common/Displays
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    Splitter Ratio: 0.5
  Tree Height: 700
- Class: rviz_common/Views
  Name: Views
  Expanded:
  - ''
  Splitter Ratio: 0.5
Visualization Manager:
  Class: ''
  Name: root
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 10
    Plane Cell Count: 40
    Color: 160; 160; 164
    Alpha: 0.3
    Line Style:
      Line Width: 0.03
      Value: Lines
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: 0
      Z: 0
    Plane: XY
    Reference Frame: <Fixed Frame>
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: true
    Show Names: true
    Show Axes: true
    Show Arrows: false
    Marker Scale: 8
    Update Interval: 0
    Frame Timeout: 15
    Filter (whitelist): []
    Filter (blacklist): []
    Tree: {}
    Frames:
      All Enabled: true
  - Class: rviz_default_plugins/PointCloud2
    Name: drone1 lidar
    Enabled: true
    Topic:
      Value: /drone1/lidar/points
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Best Effort
      History Policy: Keep Last
      Filter size: 10
    Style: Flat Squares
    Size (m): 0.25
    Alpha: 1
    Decay Time: 0
    Position Transformer: XYZ
    Color Transformer: FlatColor
    Color: 242; 66; 54
    Queue Size: 10
    Selectable: true
    Use Fixed Frame: true
    Use rainbow: true
    Invert Rainbow: false
    Autocompute Intensity Bounds: true
    Min Color: 0; 0; 0
    Max Color: 255; 255; 255
  - Class: rviz_default_plugins/PointCloud2
    Name: rtabmap map cloud
    Enabled: true
    Topic:
      Value: /cloud_map
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Reliable
      History Policy: Keep Last
      Filter size: 10
    Style: Flat Squares
    Size (m): 0.4
    Alpha: 1
    Decay Time: 0
    Position Transformer: XYZ
    Color Transformer: AxisColor
    Color: 200; 200; 200
    Queue Size: 10
    Selectable: true
    Use Fixed Frame: true
    Use rainbow: true
    Invert Rainbow: false
    Autocompute Intensity Bounds: true
    Min Color: 0; 0; 0
    Max Color: 255; 255; 255
    Axis: Z
    Autocompute Value Bounds:
      Max Value: 60
      Min Value: -5
      Value: false
  - Class: rviz_default_plugins/Odometry
    Name: rtabmap odometry
    Enabled: true
    Topic:
      Value: /odom
      Depth: 100
      Durability Policy: Volatile
      Reliability Policy: Reliable
      History Policy: Keep Last
      Filter size: 10
    Keep: 300
    Position Tolerance: 0.5
    Angle Tolerance: 0.2
    Shape:
      Alpha: 1
      Color: 40; 220; 120
      Head Length: 0.3
      Head Radius: 0.5
      Shaft Length: 1
      Shaft Radius: 0.2
      Value: Arrow
    Covariance:
      Value: false
  - Class: rviz_default_plugins/Odometry
    Name: ground truth
    Enabled: true
    Topic:
      Value: /drone1/odom_gt
      Depth: 100
      Durability Policy: Volatile
      Reliability Policy: Best Effort
      History Policy: Keep Last
      Filter size: 10
    Keep: 300
    Position Tolerance: 0.5
    Angle Tolerance: 0.2
    Shape:
      Alpha: 1
      Color: 255; 255; 255
      Head Length: 0.3
      Head Radius: 0.5
      Shaft Length: 1
      Shaft Radius: 0.2
      Value: Arrow
    Covariance:
      Value: false
  - Class: rviz_default_plugins/MarkerArray
    Name: rtabmap pose graph + loop closures
    Enabled: true
    Topic:
      Value: /rtabmap/mapGraph
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Reliable
      History Policy: Keep Last
      Filter size: 10
    Namespaces: {}
  - Class: rviz_default_plugins/Map
    Name: occupancy grid
    Enabled: false
    Topic:
      Value: /map
      Depth: 1
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
      Filter size: 10
    Alpha: 0.7
    Color Scheme: map
    Draw Behind: true
    Update Topic:
      Value: /map_updates
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Reliable
      History Policy: Keep Last
      Filter size: 10
    Use Timestamp: false
  - Class: rviz_default_plugins/Image
    Name: drone1 left cam
    Enabled: false
    Topic:
      Value: /drone1/stereo/left/image_raw
      Depth: 2
      Durability Policy: Volatile
      Reliability Policy: Best Effort
      History Policy: Keep Last
      Filter size: 10
    Max Value: 1
    Min Value: 0
    Median window: 5
    Normalize Range: true
    Transport Hint: raw
    Queue Size: 2
  Enabled: true
  Global Options:
    Background Color: 26; 26; 30
    Fixed Frame: map
    Frame Rate: 30
    Default Light: true
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
    Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Orbit
      Distance: 400
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.9
      Yaw: 0.8
      Target Frame: <Fixed Frame>
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Near Clip Distance: 0.01
    Saved: []
  Window Geometry:
    Height: 1000
    Width: 1700
    Hide Left Dock: false
    Hide Right Dock: false
    Displays:
      collapsed: false
    Views:
      collapsed: false
    QMainWindow State: ''
