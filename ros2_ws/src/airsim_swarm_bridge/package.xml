<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>airsim_swarm_bridge</name>
  <version>0.1.0</version>
  <description>
    ROS 2 bridge for the AirSim drone-swarm workspace: publishes Drone1-4 sensors,
    odometry and TF, exposes the existing swarm/ manoeuvres as services, and converts
    recorded datasets/ runs into rosbag2 for offline SLAM benchmarking.
  </description>
  <maintainer email="thisenekanayake0330@gmail.com">Thisen Ekanayake</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>airsim_swarm_msgs</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- Raw msgpack, NOT the airsim pip package: that pins tornado<5, which is
       dead on this container's Python 3.12. See airsim_swarm_bridge/rpc.py. -->
  <exec_depend>python3-msgpack</exec_depend>

  <!-- Pulled in by the SLAM/visualisation launch files rather than the nodes. -->
  <exec_depend>rtabmap_odom</exec_depend>
  <exec_depend>rtabmap_slam</exec_depend>
  <exec_depend>octomap_server</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
